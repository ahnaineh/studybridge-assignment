# Copy to .env locally. Never commit a real key.
GEMINI_API_KEY=
# Change this to a generateContent-capable model available to your account.
# For reproducible experiments, prefer a fixed model ID instead of a latest alias.
GEMINI_MODEL=gemini-3.5-flash-lite
# This spaces model calls for a 5-request/minute free-tier quota. Adjust to your quota.
STUDYBRIDGE_MIN_REQUEST_INTERVAL=13
